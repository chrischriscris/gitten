/target

# Worktree checkouts. See docs/worktrees.md — nested inside the repo by
# convention, never committed:
/.worktrees/

# Generated and downloaded fixtures. All reproducible:
#   ./fixtures/fetch.sh              real diffs + the bun tree
#   ./fixtures/dump.sh <repo> [n]    from any local repo
#   ./fixtures/gen.sh <n> <m>        synthetic, any scale
/fixtures/*.txt
/fixtures/*.diff
/fixtures/real/

# The live config. Reproducible, and personal — colours you are in the middle of
# tuning are not the repository's business:
#   gitten config > gitten.toml
/gitten.toml
