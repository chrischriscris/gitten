#!/usr/bin/env bash
# One entry point for every client, with the development defaults already on.
#
#   ./dev                            what this says
#   ./dev tui       diff . HEAD~2..HEAD
#   ./dev desktop   commits
#   ./dev web       diff --fixtures
#   ./dev dump      commits ~/Projects/git 600     one frame, no takeover
#   ./dev check                                    everything headless
#   ./dev config                                   a starting gitten.toml
#   ./dev bundle                                   target/gitten.app, icon and all
#
#   ./dev --release tui diff .       when you need honest numbers
#   GITTEN_STATS=0 ./dev tui          without the frame readout
#
# **Debug and the stats readout by default**, because this is the loop you
# iterate in: ~2.5 s to rebuild instead of ~4 s, and the frame and cell counts
# up without having to remember an environment variable.
#
# **The timings are meaningless in a debug build.** It is a different, much
# slower binary — `[profile.dev]` is opt-level 1 for our crates — and both
# clients say so. The row counts, the cell counts and the load breakdown are
# still worth watching; the frame time is not a number to quote. Use
# `--release` before believing anything, and see docs/measurements.md.
#
# `desktop` and `web` rebuild and relaunch on every save. `tui` does not, and
# cannot: it owns the terminal's stdin, so it cannot be backgrounded for a
# watcher to sit in front of. Quit it with `q` and press up-enter — the rebuild
# is the same 2.5 s either way. `./dev dump` is the watchable one, because a
# frame on stdout interrupts nobody.
#
# Colour, font, `[diff]` and `[keys]` changes need none of this: gitten.toml
# reloads live in both clients, on the next frame. Use this for code.
set -uo pipefail
cd "$(dirname "$0")"

PROFILE=debug
FLAGS=()
while true; do
  case "${1:-}" in
    --release) PROFILE=release; FLAGS=(--release); shift ;;
    --debug)   shift ;;   # the default; accepted so it can be written explicitly
    *) break ;;
  esac
done

# On unless it was deliberately turned off — both clients treat "0" as off, so
# `GITTEN_STATS=0 ./dev tui` works and anything else the caller set is kept.
export GITTEN_STATS="${GITTEN_STATS:-1}"

WHAT="${1:-}"
[ $# -gt 0 ] && shift

# Progress on stderr, always: `./dev config > gitten.toml` has to produce a file
# with a config in it and not a build log.
dim() { printf '\033[2m%s\033[0m\n' "$1" >&2; }
red() { printf '\033[31m%s\033[0m\n' "$1" >&2; }

usage() {
  sed -n '2,33p' "$0" | sed 's/^# \{0,1\}//'
  exit "${1:-0}"
}

# Everything a client is built out of. `find -newer` walks these, so keep it to
# source: a new crate that is not here will not trigger a rebuild, and that is
# the failure mode to remember.
WATCH=(core/src core/examples git/src app/src shell/src tui/src web/src web/ui)

build() { # build <crate>
  local crate=$1 log
  log=$(mktemp)
  dim "── building $crate ───────────────────────"
  local start=$SECONDS
  # To a file, not a pipe: a pipe loses cargo's exit status under pipefail, and
  # launching a stale binary after a failed build is the one thing this must not
  # do. Output is only worth seeing when it went wrong.
  if ! cargo build "${FLAGS[@]}" -p "$crate" >"$log" 2>&1; then
    grep -vE '^\s*(Compiling|Finished|Blocking|Downloaded|Updating)' "$log"
    rm -f "$log"
    red "── build failed ──────────────────────────"
    return 1
  fi
  rm -f "$log"
  local note=""
  [ "$PROFILE" = debug ] && note=" · debug, timings meaningless"
  dim "── $((SECONDS - start))s$note ──────────────────"
}

# Rebuild and relaunch on every save. For clients that do not read stdin, which
# is why `tui` is not one of them.
watch_run() { # watch_run <crate> <binary> [args...]
  local crate=$1 bin=$2
  shift 2
  local marker running=""
  marker=$(mktemp)

  cleanup() {
    [ -n "$running" ] && kill "$running" 2>/dev/null
    rm -f "$marker"
    exit 0
  }
  trap cleanup INT TERM

  cycle() {
    # Kill first: two of them fighting over one session file or one port is
    # confusing, and the binary underneath the running one is about to be
    # replaced anyway.
    if [ -n "$running" ]; then
      kill "$running" 2>/dev/null
      wait "$running" 2>/dev/null
      running=""
    fi
    build "$crate" || return
    "$bin" "$@" &
    running=$!
  }

  cycle "$@"
  # POSIX, no dependencies, and `-quit` stops at the first hit instead of
  # walking the whole tree. 400 ms of latency on a 3-second rebuild is nothing.
  while true; do
    sleep 0.4
    if [ -n "$(find "${WATCH[@]}" \( -name '*.rs' -o -name '*.toml' -o -name '*.js' \
                -o -name '*.css' -o -name '*.html' \) -newer "$marker" -print -quit 2>/dev/null)" ]; then
      touch "$marker"
      cycle "$@"
    fi
    # Closed by hand: stop, rather than leaving a watcher running in a terminal
    # you have stopped looking at.
    if [ -n "$running" ] && ! kill -0 "$running" 2>/dev/null; then
      dim "── it exited ─────────────────────────────"
      cleanup
    fi
  done
}

case "$WHAT" in
  desktop|shell|gui)
    watch_run gitten-shell "target/$PROFILE/gitten-shell" "$@"
    ;;

  web|browser)
    watch_run gitten-web "target/$PROFILE/gitten-web" "$@"
    ;;

  tui|terminal)
    build gitten-tui || exit 1
    # In the foreground: it reads the terminal, so there is nothing to put in
    # front of it. Raw mode and the alternate screen are restored on exit and on
    # panic by `term.rs`; this is the belt for the case it is killed instead.
    "target/$PROFILE/gitten-tui" "$@"
    status=$?
    printf '\033[?25h\033[?1049l'
    stty sane 2>/dev/null
    exit $status
    ;;

  dump)
    # One frame of the terminal views on stdout, the timing on stderr. Release
    # by default here and nowhere else: the whole reason to run it is the
    # number, and a debug one is not a number.
    : "${COLS:=$(tput cols 2>/dev/null || echo 120)}"
    : "${ROWS:=$(tput lines 2>/dev/null || echo 40)}"
    export COLS ROWS
    exec cargo run -q -p gitten-tui --example dump --release -- "$@"
    ;;

  bundle)
    # A real `.app`. Three things a bare binary cannot have: an icon, a name in
    # the menu bar that is not the executable's, and a window that comes to the
    # front on its own — `cx.activate(true)` is the dev workaround for the last
    # one and a bundle is the answer.
    #
    # Release always: nobody wants a debug build in /Applications, and the
    # timings inside one are meaningless anyway.
    FLAGS=(--release); PROFILE=release
    build gitten-shell || exit 1
    APP="target/gitten.app"
    rm -rf "$APP" "target/gitten.iconset"
    mkdir -p "$APP/Contents/MacOS" "$APP/Contents/Resources" target/gitten.iconset

    # Rendered from the vector at every size rather than downscaled from one
    # PNG: at 16 and 32 the difference between a re-rendered glyph and a
    # resampled one is the whole legibility of the thing.
    for pair in "16 16x16" "32 16x16@2x" "32 32x32" "64 32x32@2x" \
                "128 128x128" "256 128x128@2x" "256 256x256" "512 256x256@2x" \
                "512 512x512" "1024 512x512@2x"; do
      set -- $pair
      rm -rf target/.ql && mkdir -p target/.ql
      qlmanage -t -s "$1" -o target/.ql shell/assets/icon.svg >/dev/null 2>&1
      cp target/.ql/icon.svg.png "target/gitten.iconset/icon_$2.png"
    done
    rm -rf target/.ql
    iconutil -c icns target/gitten.iconset -o "$APP/Contents/Resources/gitten.icns"
    rm -rf target/gitten.iconset

    # The executable is named `gitten` inside the bundle: macOS titles the first
    # menu with CFBundleName, and the binary being `gitten-shell` is why the menu
    # bar says so today.
    cp "target/$PROFILE/gitten-shell" "$APP/Contents/MacOS/gitten"
    cat > "$APP/Contents/Info.plist" <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key><string>gitten</string>
  <key>CFBundleDisplayName</key><string>gitten</string>
  <key>CFBundleExecutable</key><string>gitten</string>
  <key>CFBundleIdentifier</key><string>dev.gitten.desktop</string>
  <key>CFBundleIconFile</key><string>gitten</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>0.0.0</string>
  <key>CFBundleVersion</key><string>0</string>
  <key>LSMinimumSystemVersion</key><string>11.0</string>
  <!-- Without this the window is drawn at 1x and upscaled, which on a diff of
       text is the difference between crisp and soft. -->
  <key>NSHighResolutionCapable</key><true/>
</dict>
</plist>
PLIST
    # Ad-hoc, so Gatekeeper and the icon cache treat it as a real app rather
    # than a folder that happens to be shaped like one. Not a substitute for a
    # Developer ID signature when this is ever distributed.
    codesign --force --deep --sign - "$APP" >/dev/null 2>&1 \
      || dim "── unsigned; the icon may take a moment to appear ──"
    dim "── $APP ─────────────────────────"
    echo "$APP"
    ;;

  check)
    exec ./check.sh
    ;;

  config)
    build gitten-tui || exit 1
    exec "target/$PROFILE/gitten-tui" config
    ;;

  ""|-h|--help|help)
    usage 0
    ;;

  *)
    red "no such client: $WHAT"
    echo
    usage 1
    ;;
esac
